{
  "components": {
    "schemas": {
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "The stable machine-readable code to switch on; the enum is closed",
            "type": "string"
          },
          "detail": {
            "description": "An explanation specific to this occurrence",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code, repeated for client convenience",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary; it does not vary with the occurrence",
            "type": "string"
          },
          "type": {
            "description": "A URI reference to the documentation for this error code",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "\"ok\" for liveness, \"ready\" for readiness",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "pat": {
        "description": "A personal access token, sent as `Authorization: Bearer nprs_pat_…`, where the prefix is followed by an 8-character public identifier and the secret. A token in a query string is rejected with 401, with no exception: query strings land in access logs, proxy logs and browser history.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "description": "A browser session. It is the only credential that satisfies a capability-floor operation — minting tokens, changing owners, setting trust — because a token that could perform one would be equivalent to the account.",
        "in": "cookie",
        "name": "__Host-regserve_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The plugin registry for nParse+.\n\n`GET /index.json` and `GET /plugins/{id}/index.json` serve the schema-v1 index document parsed by released nParse+ desktop clients. Their shape is defined upstream, by the pydantic models in `nparseplus.core.plugins.registry`, and is not part of this API's versioning: they sit outside `/api/v1` at fixed paths and may never move (ADR-0009).",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "nParse+ plugin registry",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
