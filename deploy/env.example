# Copy to `.env` NEXT TO compose.yaml on the droplet. Never commit the real thing.
#
#   install -m 600 /dev/null .env    # create it 0600 BEFORE writing secrets into it
#
# These stay on the host on purpose. A secret routed through CI is a secret in that pipeline's
# logs, its cache, and the context of every pull request from a fork.
#
# The CATALOGUE is not here. It is `seed.json`, next to this file, mounted read-only into the
# container — see docs/operations/deployment.md. A missing seed.json fails `compose up`, on purpose.
#
# Only REGSERVE_HOST, REGSERVE_IMAGE, the TRAEFIK_* names and REGSERVE_LOG_LEVEL do anything today.
# The rest are read from Phase 1 and Phase 2 onwards and are listed now so this file is complete
# before the release that needs them; each is marked below.

# The subdomain Traefik routes to this service.
REGSERVE_HOST=nparseplugins.prokopto.dev

# The external Docker network Traefik watches. `docker network ls` if you are not sure.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT_HTTP=http
TRAEFIK_ENTRYPOINT_HTTPS=https
TRAEFIK_CERTRESOLVER=http

# The image the deploy workflow writes here. Leave it; CI rewrites this line on each deploy.
REGSERVE_IMAGE=ghcr.io/prokopto-dev/nparse-plugin-regserve:latest

# Consumed: the server reads this when --log-level is not passed. debug, info, warn or error.
REGSERVE_LOG_LEVEL=info

# --- Secrets — none of these is read yet; publishing and OAuth land in Phase 2 -----------------

# Keys every PAT hash in the database. Generate once with:
#   openssl rand -base64 32
#
# ROTATING THIS INVALIDATES EVERY ISSUED TOKEN, because the stored value is
# HMAC-SHA256(pepper, secret) and there is no way to re-derive it. Every plugin pipeline then fails
# to publish until its owner mints a new token. Treat it as permanent unless it has leaked.
REGSERVE_TOKEN_PEPPER=

# The GitHub OAuth application. GitHub is the only identity provider (ADR-0011), so this is the
# only pair of these. Callback URL: https://$REGSERVE_HOST/auth/github/callback
REGSERVE_GITHUB_CLIENT_ID=
REGSERVE_GITHUB_CLIENT_SECRET=
